{
  "name": "@rajio/monorepo",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write '**/*.{ts,js,mjs}'",
    "landing:build": "pnpm -C apps/landing run build",
    "landing:deploy": "pnpm -C apps/landing run deploy",
    "landing:dev": "pnpm -C apps/landing run dev",
    "release": "bumpp package.json packages/*/package.json skills/rajio/SKILL.md --commit --push --tag",
    "test:ci": "turbo run test:ci",
    "typecheck": "turbo run typecheck",
    "preversion": "turbo run test:ci"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "bumpp": "latest",
    "prettier": "^3.8.5",
    "tsdown": "^0.22.14",
    "tsx": "^4.22.4",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=v24.0.0"
  }
}
